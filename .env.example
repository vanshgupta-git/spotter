# ==========================================================
# Weather-Aware Truck Routing - Environment Configuration
# All defaults work out-of-the-box with ZERO-COST free APIs!
# ==========================================================

# Backend Django Settings
DEBUG=False
SECRET_KEY=change-in-production-use-a-strong-secret-key-32chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app,.onrender.com

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: OpenRouteService API key (if empty, defaults to OSRM public engine)
# Free sign-up at https://openrouteservice.org (2,000 requests/day free)
ORS_API_KEY=

# Routing Engine Provider: 'osrm' or 'openrouteservice' (defaults to 'osrm' which requires NO key)
ROUTING_PROVIDER=osrm

# Open-Meteo Weather API Base URL (free, no API key required for non-commercial use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Frontend Configuration (for Vite frontend)
VITE_API_BASE_URL=http://localhost:8000
